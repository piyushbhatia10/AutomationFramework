# The framework reads secrets from the environment; do not place credentials in framework.json.
QA_CONFIG_FILE=framework.json
QA_API_TOKEN=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=

# AWS Redshift
REDSHIFT_HOST=
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=

# Databricks SQL
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Optional AI test-design assistant (OpenAI-compatible SDK)
OPENAI_API_KEY=
OPENAI_MODEL=
